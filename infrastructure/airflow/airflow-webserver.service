[Unit]
Description=Apache Airflow webserver for IT Job Lakehouse
After=postgresql.service

[Service]
User=womcloud
EnvironmentFile=/home/womcloud/airflow/airflow.env
Environment=AIRFLOW_HOME=/home/womcloud/airflow
WorkingDirectory=/home/womcloud/IT-Job-Data-Lakehouse
ExecStart=/home/womcloud/airflow_env/bin/airflow webserver --port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
