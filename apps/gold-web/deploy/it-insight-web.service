[Unit]
Description=IT Insight Gold Web (template; do not enable before approval)
After=network.target postgresql.service

[Service]
Type=simple
User=womcloud
WorkingDirectory=/home/womcloud/services/it-insight/current
EnvironmentFile=/home/womcloud/services/it-insight/config/web.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/womcloud/services/it-insight/current/.venv/bin/python -m uvicorn server.app:app --app-dir /home/womcloud/services/it-insight/current --root-path /insights --host 127.0.0.1 --port 8010 --workers 1 --limit-concurrency 16 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
