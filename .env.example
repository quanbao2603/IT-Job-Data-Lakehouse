# Copy to .env and replace placeholders locally. Never commit .env.
# The VPS project uses MinIO on localhost; local development may use the same.
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_SECURE=false
MINIO_LANDING_BUCKET=landing
MINIO_BRONZE_BUCKET=bronze

# Backward-compatible aliases used by older code paths. Keep aligned if used.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Optional MinIO Console URL. For local Docker-only use, leave empty or use:
# MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
# VPS value is intentionally not copied into this template.
MINIO_BROWSER_REDIRECT_URL=
